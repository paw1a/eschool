FROM golang:1.23-alpine AS builder

RUN apk update && apk upgrade && apk add --no-cache bash git openssh

WORKDIR /github.com/paw1a/eschool/
COPY . /github.com/paw1a/eschool/

RUN go mod download

RUN GOOS=linux go build -o ./.bin/app ./cmd/web/main.go


FROM alpine

WORKDIR /app

COPY --from=builder /github.com/paw1a/eschool/.bin/ .
COPY --from=builder /github.com/paw1a/eschool/config/ ./config/
COPY --from=builder /github.com/paw1a/eschool/docs/ ./docs/

EXPOSE 8080

CMD ["./app"]